# Your Pyas API key. Start with a test key (pyas_sk_test_...): it works only in your app's
# sandbox, which has sample people, calendars and events and doesn't affect real calendars.
# Connecting a real calendar requires a live key (pyas_sk_...).
PYAS_API_KEY=pyas_sk_test_your_key

# The signing secret of your webhook endpoint (whsec_...). While you develop, run
#   npx @pyas/cli webhooks listen --forward http://localhost:3000/api/pyas/webhooks
# and use the secret it prints.
PYAS_WEBHOOK_SECRET=whsec_your_secret
