# Your Pyas API key. Start with a test key (pyas_sk_test_...): it works only in your app's
# sandbox, which has sample people, calendars and events and doesn't affect real calendars.
PYAS_API_KEY=pyas_sk_test_your_key

# The model's key. The chat uses OpenAI; to use another provider, change app/api/chat/route.ts.
OPENAI_API_KEY=sk-your_key
