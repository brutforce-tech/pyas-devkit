{
  "name": "@pyas/ai-tools",
  "version": "1.0.0",
  "description": "Pyas's calendar tools for AI agents: Google, Outlook and Zoom calendars as tools for the Vercel AI SDK, LangChain and LangGraph, OpenAI function calling and Anthropic tool use.",
  "keywords": [
    "pyas",
    "calendar",
    "ai-agents",
    "tools",
    "function-calling",
    "vercel-ai-sdk",
    "langchain",
    "openai",
    "anthropic",
    "google-calendar",
    "outlook-calendar"
  ],
  "homepage": "https://developer.pyas.io",
  "license": "MIT",
  "author": "Pyas Team <support@pyas.io>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./vercel": {
      "import": { "types": "./dist/vercel.d.ts", "default": "./dist/vercel.js" },
      "require": { "types": "./dist/vercel.d.cts", "default": "./dist/vercel.cjs" }
    },
    "./langchain": {
      "import": { "types": "./dist/langchain.d.ts", "default": "./dist/langchain.js" },
      "require": { "types": "./dist/langchain.d.cts", "default": "./dist/langchain.cjs" }
    },
    "./openai": {
      "import": { "types": "./dist/openai.d.ts", "default": "./dist/openai.js" },
      "require": { "types": "./dist/openai.d.cts", "default": "./dist/openai.cjs" }
    },
    "./anthropic": {
      "import": { "types": "./dist/anthropic.d.ts", "default": "./dist/anthropic.js" },
      "require": { "types": "./dist/anthropic.d.cts", "default": "./dist/anthropic.cjs" }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@pyas/sdk": "1.0.0",
    "zod": "^3.25.76 || ^4.0.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.3.4",
    "@langchain/langgraph": ">=1.0.0",
    "ai": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": { "optional": true },
    "@langchain/langgraph": { "optional": true },
    "ai": { "optional": true }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@langchain/core": "^1.3.5",
    "@langchain/langgraph": "^1.7.2",
    "ai": "^7.0.145",
    "openai": "^7.39.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
