{
  "name": "@pyas/mcp",
  "version": "1.0.0",
  "description": "Pyas's MCP server: calendars for AI agents (Google, Outlook and Zoom through one API), and the Pyas API's reference, errors and request logs for coding agents.",
  "keywords": [
    "pyas",
    "mcp",
    "model-context-protocol",
    "calendar",
    "ai-agents",
    "google-calendar",
    "outlook-calendar"
  ],
  "homepage": "https://developer.pyas.io",
  "license": "MIT",
  "author": "Pyas Team <support@pyas.io>",
  "type": "module",
  "bin": {
    "pyas-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "generate:recipes": "node scripts/generate-recipes.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p recipes/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@pyas/ai-tools": "1.0.0",
    "@pyas/sdk": "1.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "express": "5.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
